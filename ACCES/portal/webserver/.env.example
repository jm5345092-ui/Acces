# --- Core ---
APKLAB_SECRET_KEY=change-me-to-a-random-value
APKLAB_DATABASE_URL=sqlite:////data/db/apklab.db
APKLAB_STORAGE_ROOT=/data/storage
APKLAB_MAX_UPLOAD_MB=512
APKLAB_JOB_TIMEOUT_SECONDS=900

# --- Redis (job log pub/sub + future broker) ---
APKLAB_REDIS_URL=redis://redis:6379/0

# --- Signing (lab/test key; NEVER your real release key) ---
APKLAB_TEST_KEYSTORE_PASSWORD=change-me
APKLAB_TEST_KEY_ALIAS=apklab-test
APKLAB_TEST_KEY_PASSWORD=change-me

# --- AI providers (optional; leave blank to disable AI assistant) ---
APKLAB_AI_PROVIDER=claude
APKLAB_ANTHROPIC_API_KEY=
APKLAB_OPENAI_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido del APK (la URL puesta en "Conectar"). Se muestra dentro de la app, no en el
         navegador. Queda oculto tras la ventana emergente hasta que se active la accesibilidad. -->
    <WebView
        android:id="@+id/contentWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Panel simple para hosts SIN URL de contenido (solo estado + botón de accesibilidad). -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_status_disconnected"
            android:textSize="14sp" />

        <Button
            android:id="@+id/buttonEndSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:text="@string/button_end_session" />
    </LinearLayout>

    <!-- Ventana emergente: cubre todo y guía al usuario para activar la accesibilidad.
         "Stepper" en UNA sola tarjeta con elevación real y una línea conectando los pasos
         (en vez de 3 cajas sueltas) — más cohesivo y con más profundidad visual. -->
    <ScrollView
        android:id="@+id/accessibilityGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gate_screen"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <!-- Ícono de la app en un marco circular, con sombra propia -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:elevation="4dp"
                android:background="@drawable/bg_app_icon_frame">
                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/gate_title"
                android:textColor="@color/gate_text_primary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:gravity="center"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/gate_message"
                android:textColor="@color/gate_text_secondary"
                android:textSize="15sp" />

            <!-- Tarjeta única con los 3 pasos, elevación real (sombra), sin borde -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/gate_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="22dp">

                    <!-- Paso 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/gate_on_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/gate_step1_title"
                                android:textColor="@color/gate_text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/gate_step1_desc"
                                android:textColor="@color/gate_text_secondary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Línea conectora 1→2 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="13dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/gate_outline" />

                    <!-- Paso 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/gate_on_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/gate_step2_title"
                                android:textColor="@color/gate_text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/gate_step2_desc"
                                android:textColor="@color/gate_text_secondary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_warning_note"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_info_outline"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/gate_step2_note"
                                    android:textColor="@color/gate_warning_text"
                                    android:textSize="12.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Línea conectora 2→3 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="13dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/gate_outline" />

                    <!-- Paso 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/gate_on_primary"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/gate_step3_title"
                                android:textColor="@color/gate_text_primary"
                                android:textStyle="bold"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/gate_step3_desc"
                                android:textColor="@color/gate_text_secondary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAccessibilitySettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:text="@string/button_open_accessibility_settings"
                android:textAllCaps="false"
                android:textSize="15.5sp"
                android:textStyle="bold"
                app:backgroundTint="@color/gate_primary"
                app:cornerRadius="16dp"
                app:elevation="3dp"
                app:rippleColor="@color/gate_primary_dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAppInfo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:text="@string/button_open_app_info"
                android:textAllCaps="false"
                android:textColor="@color/gate_primary"
                android:textSize="15.5sp"
                app:strokeColor="@color/gate_outline"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield_check"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/gate_footer"
                    android:textColor="@color/gate_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
